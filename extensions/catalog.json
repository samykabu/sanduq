    "project": {
      "name": "GitHub Project Lifecycle Sync",
      "id": "project",
      "description": "Mirror each Spec Kit feature onto a GitHub Project (v2): create a parent feature issue, advance its Status column through the Spec Kit lifecycle (open -> analysis -> engineer-review -> ready -> in-progress -> in-review -> done), and, in standalone use, create one native sub-issue per task and close it as its task is checked off (under Sanduq Workflow, Workflow owns task issues). Board-agnostic initialization lets each repo choose required/automatic or optional/manual sync hooks. Idempotent and no-regress.",
      "author": "Samy K. Abushanab",
      "version": "2.7.2",
      "download_url": "https://github.com/samykabu/sanduq/releases/download/project-v2.7.2/project.zip",
      "repository": "https://github.com/samykabu/sanduq",
      "homepage": "https://github.com/samykabu/sanduq/tree/main/extensions/project",
