{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanduq.local/schemas/checkpoint-v1.schema.json",
  "title": "Sanduq feature checkpoint v1",
  "type": "object",
  "required": ["schema_version", "run_id", "branch", "feature", "issue", "policy_digest", "dependency_digest", "policy", "commands", "receipts", "generation", "active", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "repo_path": {"type": "string", "minLength": 1, "description": "The absolute root at the time of the last write. 1.8.0+ never reads or compares it; it is written only so a pre-1.8.0 reader does not KeyError on a checkpoint this version writes, and is slated for removal once no supported release still needs it."},
    "repo_identity": {
      "description": "Portable repository identity (1.8.0+): the normalised origin remote and/or the root commit SHA, and whether this clone was shallow when recorded. Absent on a checkpoint the current repository has not yet upgraded (see repo_path).",
      "type": "object",
      "required": ["remote", "root_commit"],
      "properties": {
        "remote": {"type": ["string", "null"], "minLength": 1},
        "root_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "shallow": {"type": ["boolean", "null"]}
      }
    },
    "branch": {"type": "string", "minLength": 1},
    "target_branch": {"type": ["string", "null"]},
    "feature": {"type": "string", "pattern": "^specs/[^/]+$"},
    "issue": {"type": "string", "pattern": "^[^/]+/[^#]+#[1-9][0-9]*$"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy": {"$ref": "policy-v1.schema.json"},
    "commands": {"type": "object", "additionalProperties": {"type": "string"}},
    "receipts": {"type": "object", "additionalProperties": {"$ref": "receipt-v1.schema.json"}},
    "generation": {"type": "integer", "minimum": 0},
    "active": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["stage", "token", "claimed_at", "session_id", "context", "baseline"], "properties": {
          "stage": {"type": "string"}, "token": {"type": "string", "minLength": 1},
          "claimed_at": {"type": "string", "format": "date-time"}, "session_id": {"type": "string"},
          "context": {"type": "object"}, "baseline": {"type": "object"}
        }}
      ]
    },
    "status": {"enum": ["in-progress", "paused", "ready_to_finalize", "pr_open", "blocked", "failed"]},
    "migrations": {
      "description": "Reviewed migrations. workflow.py migrate --preview returns the same invalidated and preserved lists before the write.",
      "type": "array",
      "items": {"type": "object", "required": ["reason", "from", "at", "invalidated", "preserved_as_historical"], "properties": {
        "reason": {"type": "string", "minLength": 1}, "from": {"type": "string"}, "to": {"type": "string"},
        "at": {"type": "string", "format": "date-time"}, "policy_from": {"type": "string"}, "policy_to": {"type": "string"},
        "invalidated": {"type": "array", "items": {"type": "string"}},
        "preserved_as_historical": {"type": "array", "items": {"type": "string"}}
      }}
    },
    "relocations": {
      "description": "Explicit, reviewed workflow.py relocate entries: a repo identity that legitimately moved (a fork, a renamed remote, a migrated org). Never invalidates a receipt.",
      "type": "array",
      "items": {"type": "object", "required": ["actor", "at", "reason", "old_identity", "new_identity"], "properties": {
        "actor": {"type": "string", "minLength": 1}, "at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1},
        "old_identity": {"type": "object"}, "new_identity": {"type": "object"},
        "branch_rebound": {"type": "boolean"}, "branch_from": {"type": "string"}, "branch_to": {"type": "string"},
        "repository_renamed": {"type": "boolean"}, "old_repository": {"type": "string"}, "new_repository": {"type": "string"}
      }}
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "head": {"type": "string"}
  }
}
