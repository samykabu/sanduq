{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanduq workflow project policy v1",
  "type": "object",
  "required": [
    "schema_version",
    "processes",
    "execution",
    "providers",
    "issue_sync",
    "clarification",
    "context",
    "finalize",
    "updates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "processes": {
      "type": "object",
      "required": [
        "qa",
        "user_manual"
      ],
      "properties": {
        "qa": {
          "type": "boolean"
        },
        "user_manual": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "engine",
        "checkpoints"
      ],
      "properties": {
        "engine": {
          "enum": [
            "auto",
            "speckit",
            "superspec"
          ]
        },
        "checkpoints": {
          "enum": [
            "required-only",
            "every-phase"
          ]
        }
      }
    },
    "providers": {
      "type": "object",
      "required": [
        "clarification",
        "tasks"
      ],
      "properties": {
        "clarification": {
          "enum": [
            "prefer-superspec",
            "core",
            "superspec"
          ]
        },
        "tasks": {
          "enum": [
            "prefer-superspec",
            "core",
            "superspec"
          ]
        }
      }
    },
    "issue_sync": {
      "const": {
        "taskstoissues": "required",
        "parent_link": "native-subissue"
      }
    },
    "context": {
      "type": "object",
      "required": [
        "mode",
        "max_fraction",
        "checkpoint_fraction",
        "reserve_fraction"
      ],
      "properties": {
        "mode": {
          "enum": [
            "strict",
            "measured-only",
            "measured-with-estimated-fallback"
          ]
        },
        "max_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        },
        "checkpoint_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        },
        "reserve_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        }
      }
    },
    "finalize": {
      "const": {
        "create_pr": true,
        "merge": false
      }
    },
    "ci": {
      "type": "object",
      "description": "Where and how this project runs the CI workflow files Sanduq renders for it.",
      "required": [
        "provider",
        "policy",
        "runners",
        "capabilities"
      ],
      "properties": {
        "provider": {
          "enum": [
            "github-actions",
            "none"
          ]
        },
        "policy": {
          "enum": [
            "hosted-allowed",
            "self-hosted-required"
          ],
          "description": "Under self-hosted-required every GitHub-hosted runner set needs a matching exceptions entry."
        },
        "runners": {
          "type": "object",
          "required": [
            "linux"
          ],
          "additionalProperties": false,
          "properties": {
            "linux": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "windows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "macos": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "system_packages",
            "python",
            "python_version"
          ],
          "additionalProperties": false,
          "properties": {
            "system_packages": {
              "enum": [
                "sudo-apt",
                "preinstalled"
              ]
            },
            "python": {
              "enum": [
                "setup-action",
                "preinstalled"
              ]
            },
            "python_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "workflow",
              "platform",
              "reason",
              "removed_by",
              "decided"
            ],
            "additionalProperties": false,
            "properties": {
              "workflow": {
                "type": "string",
                "minLength": 1
              },
              "platform": {
                "enum": [
                  "linux",
                  "windows",
                  "macos"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "removed_by": {
                "type": "string",
                "minLength": 1
              },
              "decided": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      }
    }
  }
}
