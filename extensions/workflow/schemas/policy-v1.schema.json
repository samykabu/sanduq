{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanduq workflow project policy v1",
  "type": "object",
  "required": [
    "schema_version",
    "processes",
    "execution",
    "providers",
    "issue_sync",
    "clarification",
    "context",
    "finalize",
    "updates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "processes": {
      "type": "object",
      "required": [
        "qa",
        "user_manual"
      ],
      "properties": {
        "qa": {
          "type": "boolean"
        },
        "user_manual": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "engine",
        "checkpoints"
      ],
      "properties": {
        "engine": {
          "enum": [
            "auto",
            "speckit",
            "superspec"
          ]
        },
        "checkpoints": {
          "enum": [
            "required-only",
            "every-phase"
          ]
        }
      }
    },
    "providers": {
      "type": "object",
      "required": [
        "clarification",
        "tasks"
      ],
      "properties": {
        "clarification": {
          "enum": [
            "prefer-superspec",
            "core",
            "superspec"
          ]
        },
        "tasks": {
          "enum": [
            "prefer-superspec",
            "core",
            "superspec"
          ]
        }
      }
    },
    "issue_sync": {
      "const": {
        "taskstoissues": "required",
        "parent_link": "native-subissue"
      }
    },
    "decisions": {
      "type": "object",
      "description": "Stage-neutral GitHub issue decisions; omitted in older policies.",
      "required": ["transport", "authorized_users", "project_field"],
      "additionalProperties": false,
      "properties": {
        "transport": {"const": "github-issue"},
        "authorized_users": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "project_field": {"type": "string", "minLength": 1}
      }
    },
    "context": {
      "type": "object",
      "required": [
        "mode",
        "max_fraction",
        "checkpoint_fraction",
        "reserve_fraction"
      ],
      "properties": {
        "mode": {
          "enum": [
            "strict",
            "measured-only",
            "measured-with-estimated-fallback"
          ]
        },
        "max_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        },
        "checkpoint_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        },
        "reserve_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        }
      }
    },
    "finalize": {
      "const": {
        "create_pr": true,
        "merge": false
      }
    },
    "delegation": {
      "type": "object",
      "description": "Optional model-aware delegation; absent legacy policies default to disabled.",
      "additionalProperties": false,
      "required": ["enabled", "install_scope", "stronger_retry", "models", "routes", "overrides"],
      "properties": {
        "enabled": {"type": "boolean"},
        "install_scope": {"enum": ["project", "global"]},
        "stronger_retry": {"enum": [0, 1]},
        "models": {
          "type": "object", "additionalProperties": false,
          "required": ["codex", "claude"],
          "properties": {
            "codex": {"$ref": "#/$defs/model_tiers"},
            "claude": {"$ref": "#/$defs/model_tiers"}
          }
        },
        "routes": {
          "type": "object", "additionalProperties": false,
          "required": ["discovery", "implementation", "qa", "documentation", "review", "coordination"],
          "properties": {
            "discovery": {"$ref": "#/$defs/delegation_route"},
            "implementation": {"$ref": "#/$defs/delegation_route"},
            "qa": {"$ref": "#/$defs/delegation_route"},
            "documentation": {"$ref": "#/$defs/delegation_route"},
            "review": {"$ref": "#/$defs/delegation_route"},
            "coordination": {"$ref": "#/$defs/delegation_route"}
          }
        },
        "overrides": {
          "type": "object", "patternProperties": {
            "^specs/[^/]+/T[0-9]{3,}$": {"$ref": "#/$defs/delegation_route"}
          }, "additionalProperties": false
        }
      }
    },
    "ci": {
      "type": "object",
      "description": "Where and how this project runs the CI workflow files Sanduq renders for it.",
      "required": [
        "provider",
        "policy",
        "runners",
        "capabilities"
      ],
      "properties": {
        "gate": {
          "type": "object",
          "description": "Project-selected Sanduq workflow evidence gate; absent on legacy installs.",
          "required": ["mode", "scope", "rules"],
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["disabled", "advisory", "required"]},
            "scope": {"enum": ["managed-only", "all-prs"]},
            "rules": {
              "type": "object",
              "required": ["receipts", "decisions", "tasks", "task_links", "documentation", "portability", "candidate_merge", "live_answers"],
              "additionalProperties": false,
              "properties": {
                "receipts": {"type": "boolean"},
                "decisions": {"type": "boolean"},
                "tasks": {"type": "boolean"},
                "task_links": {"type": "boolean"},
                "documentation": {"type": "boolean"},
                "portability": {"type": "boolean"},
                "candidate_merge": {"type": "boolean"},
                "live_answers": {"type": "boolean"}
              }
            }
          }
        },
        "provider": {
          "enum": [
            "github-actions",
            "none"
          ]
        },
        "policy": {
          "enum": [
            "hosted-allowed",
            "self-hosted-required"
          ],
          "description": "Under self-hosted-required every GitHub-hosted runner set needs a matching exceptions entry."
        },
        "runners": {
          "type": "object",
          "required": [
            "linux"
          ],
          "additionalProperties": false,
          "properties": {
            "linux": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "windows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "macos": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "system_packages",
            "python",
            "python_version"
          ],
          "additionalProperties": false,
          "properties": {
            "system_packages": {
              "enum": [
                "sudo-apt",
                "preinstalled"
              ]
            },
            "python": {
              "enum": [
                "setup-action",
                "preinstalled"
              ]
            },
            "python_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "workflow",
              "platform",
              "reason",
              "removed_by",
              "decided"
            ],
            "additionalProperties": false,
            "properties": {
              "workflow": {
                "type": "string",
                "minLength": 1
              },
              "platform": {
                "enum": [
                  "linux",
                  "windows",
                  "macos"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "removed_by": {
                "type": "string",
                "minLength": 1
              },
              "decided": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "model_tiers": {
      "type": "object", "additionalProperties": false,
      "required": ["high", "standard", "light", "documentation", "review"],
      "properties": {
        "high": {"type": "string", "minLength": 1},
        "standard": {"type": "string", "minLength": 1},
        "light": {"type": "string", "minLength": 1},
        "documentation": {"type": "string", "minLength": 1},
        "review": {"type": "string", "minLength": 1}
      }
    },
    "delegation_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["harness"],
      "properties": {
        "harness": {"enum": ["selected", "codex", "claude"]},
        "tier": {"enum": ["high", "standard", "light", "documentation", "review"]},
        "model": {"type": ["string", "null"]}
      },
      "oneOf": [{"required": ["tier"], "not": {"required": ["model"]}},
                 {"required": ["model"], "not": {"required": ["tier"]}}]
    },
    "delegation_route": {
      "type": "object", "additionalProperties": false,
      "required": ["preferred", "fallbacks"],
      "properties": {
        "preferred": {"$ref": "#/$defs/delegation_candidate"},
        "fallbacks": {"type": "array", "maxItems": 5,
                      "items": {"$ref": "#/$defs/delegation_candidate"}}
      }
    }
  }
}
