{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanduq.local/schemas/receipt-v1.schema.json",
  "title": "Sanduq completed stage receipt v1",
  "type": "object",
  "required": ["stage", "outcome", "summary", "inputs", "evidence", "command", "dependency_digest", "fingerprints", "completed_at"],
  "properties": {
    "stage": {"enum": ["scope", "specify", "clarify", "plan", "tasks", "qa_analyze", "manual_analyze", "analyze", "taskstoissues", "execute", "verify", "review", "qa_document", "manual_update", "ready", "pr"]},
    "outcome": {"const": "passed"},
    "summary": {"type": "string", "minLength": 1},
    "inputs": {"$ref": "#/$defs/paths"},
    "evidence": {"$ref": "#/$defs/paths"},
    "command": {"type": "string", "minLength": 1},
    "dependency_digest": {"$ref": "#/$defs/hash"},
    "fingerprints": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "source_fingerprints": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "completed_at": {"type": "string", "format": "date-time"},
    "unresolved": {"const": 0},
    "answers_applied": {"const": true},
    "blocking_findings": {"const": 0},
    "native_links_verified": {"const": true},
    "parent_issue": {"type": "string", "pattern": "^[^/]+/[^#]+#[1-9][0-9]*$"},
    "images_verified": {"const": true},
    "pr_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[1-9][0-9]*$"},
    "input_roles": {
      "description": "Optional declared role per input path; every key is listed in inputs. A receipt without it is read as all-dependency.",
      "type": "object", "additionalProperties": {"$ref": "#/$defs/input_role"}
    },
    "amendments": {
      "description": "Assessed evidence amendments recorded by workflow.py amend. Written by the runtime only.",
      "type": "array", "items": {"$ref": "#/$defs/amendment"}
    },
    "stale": {
      "description": "Written by the runtime only. evidence-amended: a changed amendment of earlier evidence undermined this receipt; it must be re-recorded. ci-lane-gap: a CI run offered as Verify evidence missed lanes the source drift affects; a run covering them closes it through revalidate.",
      "oneOf": [
        {"type": "object", "required": ["reason", "stage", "path", "at"],
         "properties": {"reason": {"const": "evidence-amended"}, "stage": {"type": "string"},
                        "path": {"type": "string", "minLength": 1}, "at": {"type": "string", "format": "date-time"}}},
        {"type": "object", "required": ["reason", "stage", "lanes", "run_id", "at"],
         "properties": {"reason": {"const": "ci-lane-gap"}, "stage": {"const": "verify"},
                        "lanes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                        "run_id": {"type": "integer"}, "at": {"type": "string", "format": "date-time"}}}
      ]
    },
    "head": {"description": "Optional commit the receipt was recorded at.", "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "source_key": {"description": "Optional canonical source key at head, distinct from source_fingerprints. Without it the identity rule applies.", "$ref": "#/$defs/hash"},
    "ci_evidence": {
      "description": "Optional CI run accepted as verification evidence, written by workflow.py revalidate --stage verify --check-run only. The gate accepts a Verify receipt whose source drifted when this run concluded success on the current source key with no lane gap.",
      "type": "object",
      "required": ["run_id", "head", "source_key", "tier", "lanes", "conclusion"],
      "properties": {"run_id": {"type": ["integer", "string"]}, "attempt": {"type": "integer"},
                     "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "source_key": {"$ref": "#/$defs/hash"},
                     "tier": {"type": "string"}, "lanes": {"type": "array", "items": {"type": "string"}},
                     "conclusion": {"const": "success"}, "check": {"type": "string"}, "artifact": {"type": "string"},
                     "event": {"type": "string"}, "pull_request": {"type": ["integer", "null"]},
                     "required_lanes": {"type": "array", "items": {"type": "string"}},
                     "lane_gap": {"type": "array", "maxItems": 0}, "at": {"type": "string", "format": "date-time"}}
    },
    "diff_reviewed": {
      "description": "Optional record of an incremental review of git diff <base>..<head>, written by workflow.py revalidate --stage review --diff-reviewed only.",
      "type": "object",
      "required": ["evidence", "base", "head"],
      "properties": {"evidence": {"type": "string", "minLength": 1}, "base": {"type": "string"}, "head": {"type": "string"},
                     "hash": {"$ref": "#/$defs/hash"}, "at": {"type": "string", "format": "date-time"}}
    },
    "revalidations": {
      "description": "Checked revalidations of a Verify, Review or Ready receipt after source drift (workflow.py revalidate). Written by the runtime only; an entry with outcome stale records a lane gap and changed nothing else.",
      "type": "array",
      "items": {"type": "object", "required": ["via", "at", "actor", "outcome"], "properties": {
        "via": {"enum": ["check-run", "diff-review", "ready-checks"]}, "at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1}, "outcome": {"enum": ["current", "stale"]},
        "reason": {"type": ["string", "null"]}, "drift": {"type": "array", "items": {"type": "string"}}
      }}
    }
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "clarify"}}}, "then": {"required": ["unresolved", "answers_applied"]}},
    {"if": {"properties": {"stage": {"const": "taskstoissues"}}}, "then": {"required": ["parent_issue", "native_links_verified"]}},
    {"if": {"properties": {"stage": {"enum": ["verify", "review", "ready"]}}}, "then": {"required": ["blocking_findings", "source_fingerprints"]}},
    {"if": {"properties": {"stage": {"const": "pr"}}}, "then": {"required": ["pr_url", "images_verified"]}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "input_role": {
      "type": "object", "required": ["role"], "additionalProperties": false,
      "properties": {"role": {"enum": ["dependency", "consulted"]}, "because": {"type": "string", "minLength": 1}},
      "if": {"properties": {"role": {"const": "consulted"}}}, "then": {"required": ["because"]}
    },
    "amendment": {
      "type": "object", "required": ["path", "old_hash", "new_hash", "reason", "assessment", "actor", "at"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "old_hash": {"$ref": "#/$defs/hash"}, "new_hash": {"$ref": "#/$defs/hash"},
        "reason": {"type": "string", "minLength": 1}, "assessment": {"enum": ["unchanged", "changed"]},
        "actor": {"type": "string", "minLength": 1}, "at": {"type": "string", "format": "date-time"},
        "staled": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
